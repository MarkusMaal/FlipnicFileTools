<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FlipnicFileToolGUI.Controls.CollisionMap"
             xmlns:vm="clr-namespace:FlipnicLib.Formats;assembly=FlipnicLib"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" Margin="10,0">
        <Grid Grid.Row="0" Grid.Column="0"  RowDefinitions="30,*" Margin="0,10">
            <Label>Walls:</Label>
            <ListBox Margin="0,0,0,10" ItemsSource="{Binding ColObject.Walls}" SelectionChanged="LbSelectChanged"
                     BorderThickness="1" BorderBrush="Gray" Name="WallList" Grid.Row="1">
            </ListBox>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="30,*" Margin="0,10">
            <Label>Grounds:</Label>
            <ListBox Grid.Row="1" Margin="0,0,0,10" ItemsSource="{Binding ColObject.Grounds}" SelectionChanged="LbSelectChanged"
                     BorderThickness="1" BorderBrush="Gray" Name="GroundList">
            </ListBox>
        </Grid>
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="5,10" Grid.RowDefinitions="30,*">
            <Label>Convert:</Label>
            <WrapPanel Grid.Row="1"  ItemSpacing="5" LineSpacing="10">
                <Button Name="WtoButton" Content="Wall to OBJ" Click="ExportClick" IsEnabled="False"></Button>
                <Button Name="GtoButton" Content="Ground to OBJ" Click="ExportClick" IsEnabled="False"></Button> <!-- GTO go brrr :) -->
                <Button Name="EtoButton" Content="Everything to OBJ" Click="ExportClick"></Button>
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
