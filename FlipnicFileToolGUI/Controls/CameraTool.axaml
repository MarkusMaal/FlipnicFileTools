<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:types="clr-namespace:FlipnicLib.Types;assembly=FlipnicLib"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FlipnicFileToolGUI.Controls.CameraTool"
             xmlns:controls="clr-namespace:FlipnicFileToolGUI.Controls"
             xmlns:formats="clr-namespace:FlipnicLib.Formats;assembly=FlipnicLib"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             x:CompileBindings="True">
    <Grid RowDefinitions="140, *">
        <Grid RowDefinitions="*,*,*" DataContext="{Binding CameraObject}" Margin="10" RowSpacing="10" x:DataType="controls:CameraTool">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Content="Origin: " VerticalAlignment="Center"></Label>
                <TextBox Grid.Column="1" Text="{Binding OriginX, TargetNullValue=0}" x:DataType="formats:FpnFpc" MinWidth="60" ></TextBox>
                <TextBox  Grid.Column="2" Text="{Binding OriginY, TargetNullValue=0}" x:DataType="formats:FpnFpc" MinWidth="60" ></TextBox>
                <TextBox  Grid.Column="3" Text="{Binding OriginZ, TargetNullValue=0}" x:DataType="formats:FpnFpc" MinWidth="60" ></TextBox>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Content="Target: " VerticalAlignment="Center"></Label>
                <TextBox Grid.Column="1" Text="{Binding TargetX, TargetNullValue=0}" x:DataType="formats:FpnFpc" MinWidth="60" ></TextBox>
                <TextBox Grid.Column="2" Text="{Binding TargetY, TargetNullValue=0}" x:DataType="formats:FpnFpc" MinWidth="60" ></TextBox>
                <TextBox Grid.Column="3" Text="{Binding TargetZ, TargetNullValue=0}" x:DataType="formats:FpnFpc" MinWidth="60" ></TextBox>
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Content="FOV: " VerticalAlignment="Center" MinWidth="58" ></Label>
                <TextBox Grid.Column="1" Text="{Binding Fov, TargetNullValue=0}" x:DataType="formats:FpnFpc" MinWidth="60" ></TextBox>
                <Label Grid.Column="2" Content="Frames: " VerticalAlignment="Center"></Label>
                <Label Grid.Column="3" Content="{Binding NumFramesStr, TargetNullValue='0'}" x:DataType="formats:FpnFpc" VerticalAlignment="Center"></Label>
            </Grid>
        </Grid>
        <WrapPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" ItemsAlignment="End" Margin="10" MaxWidth="300" ItemSpacing="10" LineSpacing="10">
            <Button Classes="Flat" Content="Export FPC" Click="Button_OnClick"/>
            <Button Classes="Flat" Content="Export TXT" Click="Button_OnClick"/>
            <Button Classes="Flat" Content="Export XML" Click="Button_OnClick"/>
        </WrapPanel>
        <DataGrid Grid.Row="1" Margin="0,0,0,10" GridLinesVisibility="All" ItemsSource="{Binding $parent[controls:CameraTool].CameraObject.CamFrames}" x:DataType="controls:CameraTool"
                  BorderThickness="1" BorderBrush="Gray" Name="CameraGrid"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True" DataContext="{Binding $parent[controls:CameraTool].CameraObject}"
                  CanUserSortColumns="True" SelectionMode="Single"
                  IsReadOnly="False" CellEditEnding="DataGrid_OnCellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Origin X" x:DataType="types:CameraFrame" Binding="{Binding OriginX, TargetNullValue=0}" IsReadOnly="False"></DataGridTextColumn>
                <DataGridTextColumn Header="Origin Y" x:DataType="types:CameraFrame" Binding="{Binding OriginY, TargetNullValue=0}" IsReadOnly="False"></DataGridTextColumn>
                <DataGridTextColumn Header="Origin Z" x:DataType="types:CameraFrame"  Binding="{Binding OriginZ, TargetNullValue=0}" IsReadOnly="False"></DataGridTextColumn>
                <DataGridTextColumn Header="Target X" x:DataType="types:CameraFrame" Binding="{Binding TargetX, TargetNullValue=0}" IsReadOnly="False"></DataGridTextColumn>
                <DataGridTextColumn Header="Target Y" x:DataType="types:CameraFrame" Binding="{Binding TargetY, TargetNullValue=0}" IsReadOnly="False"></DataGridTextColumn>
                <DataGridTextColumn Header="Target Z" x:DataType="types:CameraFrame" Binding="{Binding TargetZ, TargetNullValue=0}" IsReadOnly="False"></DataGridTextColumn>
                <DataGridTextColumn Header="Field of view" x:DataType="types:CameraFrame"  Binding="{Binding Fov, TargetNullValue=0}" IsReadOnly="False"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
