<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FlipnicFileToolGUI.App"
             xmlns:sukiUi="clr-namespace:SukiUI;assembly=SukiUI"
             Name="Flipnic file tool">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <NativeMenu.Menu>
        <NativeMenu Opening="NativeMenu_OnOpening">
            <NativeMenuItem Header="New window" Gesture="Meta+N" Click="NewWindowMenuItem_OnClick"></NativeMenuItem>
            <NativeMenuItem Header="Quit" Gesture="Meta+Q" Click="NativeMenuItem_OnClick"></NativeMenuItem>
            <NativeMenuItem Header="About" Click="AboutNativeMenu_OnClick"></NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>
             
    <Application.Styles>
        <sukiUi:SukiTheme ThemeColor="Blue"  />
    </Application.Styles>
</Application>