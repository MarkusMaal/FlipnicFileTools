<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FlipnicFileToolGUI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FlipnicFileToolGUI.Controls.MessageEditor"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             x:CompileBindings="True">
    <Grid ColumnDefinitions="*,*">
        <ListBox Grid.Column="0" Margin="0,0,0,10" ItemsSource="{Binding MsgObject.Messages}"
                 BorderThickness="1" BorderBrush="Gray" Name="MessageList" SelectionChanged="MessageList_OnSelectionChanged">
        </ListBox>
        <StackPanel Grid.Column="1" Spacing="10" Margin="10" DataContext="{Binding}" x:DataType="controls:MessageEditor">
            <Label Content="Table"></Label>
            <WrapPanel ItemSpacing="10" LineSpacing="10">
                <Button Classes="Flat" Content="Export TXT" Name="ExportTxtButton" Click="ExportTxtButton_OnClick" />
                <Button Classes="Flat" Content="Export MSG" Name="ExportMsgButton" Click="ExportMsgButton_OnClick" />
            </WrapPanel>
            <WrapPanel Orientation="Horizontal" ItemSpacing="10">
                <Label Name="SelIdxLabel" Content="Selection"></Label>
            </WrapPanel>
            <TextBox Name="SelectedItemTextBox" IsEnabled="{Binding ItemSelected}" Text="{Binding Text}" KeyUp="SelectedItemTextBox_OnKeyUp"></TextBox>
            <WrapPanel Orientation="Horizontal" ItemSpacing="10">
                <Button Click="ChangeButton_OnClick" IsEnabled="{Binding ItemSelected}" Classes="Flat" Content="Change"></Button>
                <Button Classes="Flat" Content="&#x2191;" IsEnabled="{Binding ItemSelected}" Click="UpButton_OnClick"></Button>
                <Button Classes="Flat" Content="&#x2193;" IsEnabled="{Binding ItemSelected}" Click="DownButton_OnClick"></Button>
                <Button Click="RemoveButton_OnClick" IsEnabled="{Binding ItemSelected}" Classes="Flat Accent" Content="Remove"></Button>
            </WrapPanel>
            <Label Content="Insert"></Label>
            <TextBox KeyUp="InsertMsgTextBox_OnKeyUp" Name="InsertMsgTextBox"/>
            <WrapPanel ItemSpacing="10" LineSpacing="10">
                <Button Classes="Flat" Content="Add" Click="InsertButton_OnClick"></Button>
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
