<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="256" d:DesignHeight="256"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             x:Class="FlipnicFileToolGUI.Controls.CircleDot"
             x:CompileBindings="False">
        <Grid>
            <Ellipse Opacity="0.75">
                <Ellipse.CacheMode>
                    <BitmapCache RenderAtScale="1" />
                </Ellipse.CacheMode>
                <Ellipse.Fill>
                    <LinearGradientBrush>
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Color="{Binding ColorA}" Offset="0"></GradientStop>
                            <GradientStop Color="{Binding ColorB}" Offset="1"></GradientStop>
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            
            <Image Margin="3" Source="{Binding Source}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" RenderOptions.BitmapInterpolationMode="HighQuality" Stretch="UniformToFill">
                <Image.CacheMode>
                    <BitmapCache RenderAtScale="4" />
                </Image.CacheMode>
            </Image>
        </Grid>
</UserControl>
