<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="240"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             x:Class="FlipnicFileToolGUI.CLIBox">
    <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <TextBlock FontFamily="Cascadia Mono,Consolas,SF Mono,Menlo,DejaVu Sans Mono,Ubuntu Mono,Noto Mono,Courier New,Monospace"
                   VerticalAlignment="Stretch" Padding="10" Foreground="Lime" Background="#e000" TextWrapping="NoWrap"
                   Text="{Binding Text}">
            <TextBlock.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="CopyClick" Header="Copy" />
                    <MenuItem Click="SaveAsClick" Header="Save as.." />
                </ContextMenu>
            </TextBlock.ContextMenu>
        </TextBlock>
    </ScrollViewer>
</UserControl>
